#!/bin/bash
# Thin wrapper: runs scripts/gates/check-closing-keywords.mjs with the repository and token set.
# Installed as a symlink in ~/.local/bin by scripts/install-gates.sh.
set -u
src=$0
while [ -L "$src" ]; do
  dir=$(cd "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
here=$(cd "$(dirname "$src")" && pwd)
. "$here/_gate-env.sh"
gate_prepare_env check-closing-keywords "$@"
exec node "$here/../check-closing-keywords.mjs" "$@"

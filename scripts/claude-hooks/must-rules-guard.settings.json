{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Agent|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/must-rules-guard.py || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

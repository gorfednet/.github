{
  "note": "Copy to ~/.ship-bot/config.json (install.sh does this once). Every repo with a non-empty todo list is refused by a live run until a person has confirmed and deleted each item. Paths may start with ~.",
  "live": false,
  "allowedAuthors": [
    "gorfednet"
  ],
  "stateDir": "~/.ship-bot",
  "workRoot": "~/.ship-bot/work",

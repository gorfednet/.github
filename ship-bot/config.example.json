  "checksGraceMinutes": 10,
  "defaultStepTimeoutMinutes": 20,
  "gateTimeoutSeconds": 180,
  "notify": true,
  "preflight": [
    {
      "name": "nas",
      "command": [
        "ssh",
        "-o",
        "BatchMode=yes",
        "-o",
        "ConnectTimeout=10",
        "gorfednas",
        "true"
      ],
      "timeoutMinutes": 1
    },
    {
      "name": "docker host",
      "command": [
        "ssh",
        "-o",
        "BatchMode=yes",
        "-o",
        "ConnectTimeout=10",
        "dapyllil",
        "true"
      ],
      "timeoutMinutes": 1,
      "note": "Tailscale SSH to dapyllil can demand a browser re-login, and the ssh key's passphrase lives in the keychain/agent; a LaunchAgent may have neither. Checked once per pass before the first deploy-mode merge."
    }
  ],
  "ghPath": "~/bin/gh",
  "scripts": {
    "assertChecksStarted": "~/Developer/gorfednet/TowIt/verification-kit/bin/assert-checks-started.mjs",
